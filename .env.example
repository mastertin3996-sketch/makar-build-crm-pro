# PostgreSQL (Neon на Vercel — задається автоматично інтеграцією)
DATABASE_URL="postgresql://user:password@localhost:5432/makar_crm?schema=public"

# Секрет для підпису JWT (згенеруйте випадковий рядок ≥32 символів)
AUTH_SECRET="change-me-to-a-long-random-secret"

# ШІ-помічник (Anthropic Claude). Без ключа — демо-режим (шаблони).
# ANTHROPIC_API_KEY="sk-ant-..."

# LiqPay (публічний і приватний ключі кабінету). Без обох ключів — демо-режим
# онлайн-оплати (фейкове посилання, ручне підтвердження).
# LIQPAY_PUBLIC_KEY="i00000000000"
# LIQPAY_PRIVATE_KEY="a1b2c3..."

# Публічна адреса застосунку — потрібна для формування result_url/server_url
# у чекауті LiqPay (посилання повернення й webhook).
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Нова Пошта (трекінг ТТН). Без ключа — демо-симуляція статусів у логістиці.
# NOVA_POSHTA_API_KEY="..."
